# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dishgenie_db
POSTGRES_USER=dishgenie_user
POSTGRES_PASSWORD=dishgenie_password
DATABASE_URL=postgresql+psycopg2://dishgenie_user:dishgenie_password@localhost:5432/dishgenie_db

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=dishgenie_minioadmin
MINIO_SECRET_KEY=dishgenie_miniopassword
MINIO_BUCKET_NAME=dishgenie-bucket
MINIO_SECURE=False

# RabbitMQ Message Broker Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=dishgenie_rmq_user
RABBITMQ_PASSWORD=dishgenie_rmq_password
RABBITMQ_QUEUE_NAME=dishgenie_tasks
RABBITMQ_FAILED_QUEUE_NAME=dishgenie_tasks_failed
RABBITMQ_MAX_RETRIES=3

# Redis Cache Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DEFAULT_TTL_SECONDS=600

# Rate Limiting Settings
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60

# Worker Execution & Logging Settings
AUTO_START_WORKER=True
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=dishgenie.log

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# OpenAI / Cloud LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
